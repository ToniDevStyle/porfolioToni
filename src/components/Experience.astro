---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCIAS = [
  {
    date: "Feb. 2025 - Presente",
    title: "Desarrollador Java · Pruebas y soporte",
    company: "NTT Data – Proyecto Asisa | Alicante, España",
    description:
      "Mantenimiento de aplicaciones de seguros con Java y Sisnet. Pruebas de APIs con Postman, depuración en Eclipse y consultas en SQL Server para localizar y corregir incidencias en entornos de pruebas y producción. Seguimiento del trabajo en Jira y control de versiones con Git.",
    highlight: true,
  },
  {
    date: "Sept. 2024 - Ene. 2025",
    title: "Prácticas DAM · Desarrollo Full Stack",
    company: "NTT Data – Proyecto Mapfre | Alicante, España",
    description:
      "Prácticas del ciclo DAM en un equipo Scrum. Desarrollo de funcionalidades con Angular y Spring Boot, trabajo con Git/Bitbucket, pipelines de CI/CD en Jenkins y revisión de calidad del código con SonarQube.",
  },
  {
    date: "2023 - 2025",
    title: "Desarrollador web",
    company: "Freelance | Remoto",
    description:
      "Webs para pequeños clientes, desde la idea hasta la publicación: diseño adaptable a móvil, maquetación con HTML, CSS, JavaScript y React, y despliegue en Netlify.",
  },
  {
    date: "2019 - 2021",
    title: "Especialista en producción",
    company: "INDEN Pharma Packaging | Ibi, España",
    description:
      "Líneas de envasado farmacéutico con altos estándares de calidad y trazabilidad: control de calidad, resolución de incidencias e informes de turno. De aquí viene mi forma de pensar en calidad y en procesos.",
    badge: "🏭 Experiencia en planta",
  },
];
---

<style>
  .exp-destacado {
    position: relative;
    padding: 16px 18px;
    background: rgba(59, 130, 246, 0.04);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 10px;
    margin-bottom: 8px;
  }
  .exp-destacado::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #3b82f6, #60a5fa, transparent);
    border-radius: 10px 10px 0 0;
  }
  .etiqueta-destacado {
    font-family: monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #60a5fa;
    margin-bottom: 6px;
  }
  .distintivo {
    display: inline-block;
    font-family: monospace;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 10px;
    background: rgba(34, 197, 94, 0.08);
    color: #86efac;
    border: 1px solid rgba(34, 197, 94, 0.2);
    margin-top: 6px;
  }
</style>

<ol class="relative mt-16">
  {
    EXPERIENCIAS.map((exp) =>
      exp.highlight ? (
        <li class="exp-destacado mb-8">
          <div class="etiqueta-destacado">💼 Puesto actual</div>
          <ExperienceItem
            date={exp.date}
            title={exp.title}
            company={exp.company}
            description={exp.description}
          />
        </li>
      ) : (
        <li>
          <ExperienceItem
            date={exp.date}
            title={exp.title}
            company={exp.company}
            description={exp.description}
          />
          {exp.badge && <span class="distintivo">{exp.badge}</span>}
        </li>
      ),
    )
  }
</ol>
