    class="rounded-lg w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between py-4"
  >
    <span class="text-sm sm:text-center text-zinc-800/90 dark:text-zinc-200/90">
      © {currentYear} Toni Vieira Rubio
    </span>

    <ul
      class="flex flex-wrap items-center mt-3 text-sm font-medium dark:text-white/90 sm:mt-0 gap-x-4 relative"
    >
      <li>
        <a
          href="https://github.com/ToniDevStyle"
          target="_blank"
          class="hover:underline text-blue-400 hover:text-blue-300 font-medium"
        >
          GitHub ↗
        </a>
      </li>
      <li>
        <a href="/cv/Toni-Vieira-Rubio-CV.pdf" target="_blank" class="hover:underline">CV</a>
      </li>
      <li>
        <a href="mailto:tvr9869@gmail.com" class="hover:underline">Contacto</a>
