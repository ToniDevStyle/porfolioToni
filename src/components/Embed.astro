<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Integración de iFrame</title>
<style>
  body {
    background-color: #1a1a2e; /* Azul oscuro */
    color: white;
    font-family: Arial, sans-serif;
  }

  .iframe-container {
    width: 100%;
    height: 70vh; /* Ajusta esto según tus necesidades */
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto; /* Centra horizontalmente */
  }

 .iframe-wrapper {
  width: 100%; /* Ajusta según tus necesidades */
  height: 100%; /* Ajusta según tus necesidades */
  border-radius: 25px; /* Esquinas redondeadas tipo tarjeta */
  overflow: hidden;
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.25),  /* sombra más suave y cercana */
              0 16px 32px rgba(0, 0, 0, 0.35); /* sombra más grande y difusa */
}

  iframe {
    width: 100%;
    height: 100%;
    border: none; /* Eliminar el borde por defecto del iframe */
  }
</style>
</head>
<body>
<div class="iframe-container">
  <div class="iframe-wrapper">
    <iframe src="https://idcardtonivr.netlify.app/"></iframe>
  </div>
</div>
</body>
</html>
