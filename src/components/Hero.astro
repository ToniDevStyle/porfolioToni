---
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import Embed from "../components/Embed.astro";
---

<style>
  /* ─────────────────────────────────────────────
     GRID — 2 columnas reales, sin divisor fantasma
  ───────────────────────────────────────────── */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: start;
    padding-top: 32px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .col-divider {
      display: none;
    }
  }

  /* ─────────────────────────────────────────────
     COLUMNA IZQUIERDA — Industrial + card
  ───────────────────────────────────────────── */
  .col-left {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .eyebrow {
    font-family: monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #3b82f6;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .eyebrow::before {
    content: "";
    width: 20px;
    height: 1px;
    background: #3b82f6;
    flex-shrink: 0;
  }

  .headline-industrial {
    font-size: clamp(36px, 5.5vw, 58px);
    font-weight: 900;
    line-height: 0.97;
    letter-spacing: -0.025em;
    margin-bottom: 22px;
  }

  .headline-industrial .word-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(59, 130, 246, 0.5);
  }

  .headline-industrial .word-blue {
    color: #3b82f6;
  }

  .sub-industrial {
    font-size: 15px;
    line-height: 1.8;
    margin-bottom: 28px;
    max-width: 400px;
  }

  /* Botones */
  .btn-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 28px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #3b82f6;
    color: #fff;
    padding: 11px 22px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
    box-shadow: 0 0 28px rgba(59, 130, 246, 0.25);
  }
  .btn-primary:hover {
    background: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 6px 36px rgba(59, 130, 246, 0.4);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: monospace;
    font-size: 12px;
    letter-spacing: 0.07em;
    color: #6b7280;
    text-decoration: none;
    transition: color 0.2s;
    padding: 11px 0;
  }
  .btn-ghost:hover {
    color: #d1d5db;
  }

  /* Card InseraSystems */
  .insera-card {
    position: relative;
    background: rgba(59, 130, 246, 0.04);
    border: 1px solid rgba(59, 130, 246, 0.14);
    border-radius: 10px;
    padding: 16px 18px;
    overflow: hidden;
    margin-bottom: 32px;
  }
  .insera-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(59, 130, 246, 0.4),
      transparent
    );
  }
  .insera-card-label {
    font-family: monospace;
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #60a5fa;
    margin-bottom: 6px;
  }
  .insera-card-text {
    font-size: 13px;
    line-height: 1.65;
    color: #9ca3af;
  }
  .insera-card-text strong {
    color: #d1d5db;
    font-weight: 500;
  }
  .insera-card-link {
    display: inline-block;
    font-family: monospace;
    font-size: 10px;
    color: #60a5fa;
    text-decoration: none;
    margin-top: 8px;
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }
  .insera-card-link:hover {
    color: #93c5fd;
  }

  /* Embed + social — parte baja col izquierda */
  .embed-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .embed-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .social-row a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
    color: #6b7280;
    text-decoration: none;
    padding: 6px 12px;
    border: 1px solid #1f2937;
    border-radius: 6px;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .social-row a:hover {
    color: #d1d5db;
    border-color: #374151;
  }

  /* ─────────────────────────────────────────────
     COLUMNA DERECHA — Dev stack
  ───────────────────────────────────────────── */
  .col-right {
    display: flex;
    flex-direction: column;
    gap: 0;
    /* Alinea visualmente con el headline industrial */
    padding-top: 6px;
  }

  .eyebrow-dev {
    font-family: monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #4b5563;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .eyebrow-dev::before {
    content: "";
    width: 20px;
    height: 1px;
    background: #374151;
    flex-shrink: 0;
  }

  .headline-dev {
    font-size: clamp(32px, 4.5vw, 50px);
    font-weight: 900;
    line-height: 0.97;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .headline-dev .dim {
    color: #6b7280;
  }
  .headline-dev .mid {
    color: #9ca3af;
  }
  .headline-dev .light {
    color: #d1d5db;
  }

  .sub-dev {
    font-size: 14px;
    line-height: 1.7;
    color: #6b7280;
    margin-bottom: 24px;
    max-width: 340px;
    border-left: 2px solid #1f2937;
    padding-left: 14px;
  }

  /* Tech pills */
  .pills-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
  }
  .pills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
  }
  .pills-row-label {
    font-family: monospace;
    font-size: 9px;
    color: #374151;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    width: 64px;
    flex-shrink: 0;
  }
  .pill {
    font-family: monospace;
    font-size: 9px;
    padding: 3px 10px;
    border-radius: 12px;
    border: 1px solid #1f2937;
    color: #6b7280;
    letter-spacing: 0.06em;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .pill:hover {
    border-color: #374151;
    color: #9ca3af;
  }
  .pill.hi {
    border-color: rgba(59, 130, 246, 0.22);
    color: #60a5fa;
    background: rgba(59, 130, 246, 0.05);
  }

  /* Divider sutil entre las dos mitades de la col derecha */
  .col-divider {
    height: 1px;
    background: linear-gradient(90deg, #1f2937, transparent);
    margin: 24px 0;
  }

  /* Stats row */
  .stats-row {
    display: flex;
    gap: 20px;
    margin-bottom: 28px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat-num {
    font-family: monospace;
    font-size: 22px;
    font-weight: 700;
    color: #d1d5db;
    line-height: 1;
  }
  .stat-num span {
    color: #3b82f6;
  }
  .stat-lbl {
    font-family: monospace;
    font-size: 9px;
    color: #4b5563;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Badge */
  .badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
</style>

<div class="max-w-7xl mx-auto">
  <div class="hero-grid">
    <!-- ════════════════════════════
         COLUMNA IZQUIERDA
    ════════════════════════════ -->
    <div class="col-left">
      <div class="eyebrow">Automatización industrial</div>

      <h1 class="headline-industrial text-gray-900 dark:text-white">
        DE TRABAJAR<br />
        EN <span class="word-outline">PLANTA</span><br />
        A <span class="word-blue">AUTOMATIZARLA.</span>
      </h1>

      <p class="sub-industrial text-gray-500 dark:text-gray-400">
        Trabajé en líneas de producción industrial.<br />
        Después aprendí a construir software.<br />
        <strong class="text-gray-800 dark:text-gray-200">
          Ahora conecto las dos cosas.
        </strong>
      </p>

      <div class="btn-row">
        <a href="https://inserasystems.com" target="_blank" class="btn-primary">
          Ver InseraSystems
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href="#proyectos" class="btn-ghost">Ver FactoryFlow →</a>
      </div>

      <div class="insera-card">
        <div class="insera-card-label">🏭 Por qué InseraSystems</div>
        <p class="insera-card-text">
          La mayoría de consultores nunca han pisado una planta como
          trabajadores.
          <strong>Yo sí — Smurfit Kappa, INDEN Pharma.</strong>
          Eso cambia completamente cómo diseñas los sistemas.
        </p>
        <a href="#sobre-mi" class="insera-card-link">Leer mi historia →</a>
      </div>

      <!-- Card 3D + badge + social -->
      <div class="embed-block">
        <div class="embed-wrapper">
          <Embed />
        </div>
        <div class="badge-row">
          <a
            href="https://www.linkedin.com/in/tonivieirarubio-informatico/"
            target="_blank"
            rel="noopener"
          >
            <Badge>Available to work</Badge>
          </a>
        </div>
        <nav class="social-row">
          <a href="mailto:info@inserasystems.com">
            <MailIcon class="size-3" />
            info@inserasystems.com
          </a>
          <a
            href="https://www.linkedin.com/in/tonivieirarubio-informatico/"
            target="_blank"
            rel="noopener"
          >
            <LinkedInIcon class="size-3" />
            LinkedIn
          </a>
        </nav>
      </div>
    </div>

    <!-- ════════════════════════════
         COLUMNA DERECHA
    ════════════════════════════ -->
    <div class="col-right">
      <div class="eyebrow-dev">Full Stack Developer · Senior</div>

      <h2 class="headline-dev">
        <span class="dim">JAVA.</span><br />
        <span class="mid">SPRING.</span><br />
        <span class="light">REACT.</span>
      </h2>

      <p class="sub-dev">
        2+ años en NTT Data y Accenture construyendo sistemas enterprise con
        microservicios y arquitectura hexagonal.
      </p>

      <!-- Stack organizado por categoría -->
      <div class="pills-group">
        <div class="pills-row">
          <span class="pills-row-label">Backend</span>
          <span class="pill hi">Java</span>
          <span class="pill hi">Spring Boot</span>
          <span class="pill hi">Microservicios</span>
          <span class="pill">Kafka</span>
          <span class="pill">JPA</span>
        </div>
        <div class="pills-row">
          <span class="pills-row-label">Frontend</span>
          <span class="pill">React</span>
          <span class="pill">Angular</span>
          <span class="pill">TypeScript</span>
          <span class="pill">React Native</span>
        </div>
        <div class="pills-row">
          <span class="pills-row-label">Infra</span>
          <span class="pill">AWS</span>
          <span class="pill">Docker</span>
          <span class="pill">Jenkins</span>
          <span class="pill">SonarQube</span>
        </div>
        <div class="pills-row">
          <span class="pills-row-label">Auto</span>
          <span class="pill hi">n8n</span>
          <span class="pill">Blue Prism</span>
          <span class="pill">Sheets API</span>
        </div>
      </div>

      <div class="col-divider"></div>

      <!-- Stats -->
      <div class="stats-row">
        <div class="stat">
          <div class="stat-num">2<span>+</span></div>
          <div class="stat-lbl">años enterprise</div>
        </div>
        <div class="stat">
          <div class="stat-num">2<span>+</span></div>
          <div class="stat-lbl">años en planta</div>
        </div>
        <div class="stat">
          <div class="stat-num">48<span>h</span></div>
          <div class="stat-lbl">deploy FactoryFlow</div>
        </div>
      </div>

      <div class="col-divider"></div>

      <!-- NTT Data como credencial visible -->
      <div style="display:flex;flex-direction:column;gap:8px">
        <div
          style="font-family:monospace;font-size:9px;color:#374151;letter-spacing:.12em;text-transform:uppercase;margin-bottom:2px"
        >
          Experiencia reciente
        </div>

        <div
          style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.02);border:1px solid #1f2937;border-radius:8px"
        >
          <div>
            <div style="font-size:13px;font-weight:600;color:#d1d5db">
              NTT Data
            </div>
            <div
              style="font-family:monospace;font-size:10px;color:#60a5fa;margin-top:1px"
            >
              Java & Full Stack · Mapfre / Asisa
            </div>
          </div>
          <div style="font-family:monospace;font-size:9px;color:#374151">
            2024 – hoy
          </div>
        </div>

        <div
          style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:rgba(255,255,255,0.02);border:1px solid #1f2937;border-radius:8px"
        >
          <div>
            <div style="font-size:13px;font-weight:600;color:#d1d5db">
              Accenture
            </div>
            <div
              style="font-family:monospace;font-size:10px;color:#f59e0b;margin-top:1px"
            >
              RPA Developer · Repsol
            </div>
          </div>
          <div style="font-family:monospace;font-size:9px;color:#374151">
            2023
          </div>
        </div>

        <div
          style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:rgba(59,130,246,0.04);border:1px solid rgba(59,130,246,0.14);border-radius:8px"
        >
          <div>
            <div style="font-size:13px;font-weight:600;color:#d1d5db">
              InseraSystems
            </div>
            <div
              style="font-family:monospace;font-size:10px;color:#34d399;margin-top:1px"
            >
              Fundador · Automatización industrial
            </div>
          </div>
          <div style="font-family:monospace;font-size:9px;color:#374151">
            2025 →
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
